<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>
/* =============================================================
   HTTPS / TLS ABSTRACT MODEL — UPPAAL
   CVE-2014-3566 (POODLE) + CVE-2014-0160 (Heartbleed)
   Student project — Faculté des Sciences de Tunis
   ============================================================= */

/* Channels — binary for handshake, broadcast for data/alert */
chan ch_clientHello;
chan ch_serverHello;
chan ch_clientFinished;
broadcast chan ch_appData;
broadcast chan ch_alert;

/* Heartbleed channels — binary so Server must respond to Attacker */
chan ch_heartbeatReq;
chan ch_heartbeatResp;

/* Session flags */
bool session_client      = false;
bool session_established = false;

/* Handshake timeout */
clock c_timer;
const int TIMEOUT = 30;

/* POODLE — CVE-2014-3566 */
int[0,3] version_negotiated = 3;
bool poodle_success          = false;
int  retry_count             = 0;
const int MAX_RETRY          = 3;

/* Heartbleed — CVE-2014-0160
   heartbeat_length : longueur declaree par l attaquant
   payload_size     : taille reelle du payload envoye
   memory_leak      : positionne par le Serveur apres reponse
   hb_success       : confirme par l attaquant apres observation */
int  heartbeat_length = 5;
int  payload_size     = 1;
bool memory_leak      = false;
bool hb_success       = false;
</declaration>
	<template>
		<name>Client</name>
		<location id="id0" x="40" y="80">
			<name x="25" y="50">Init</name>
		</location>
		<location id="id1" x="220" y="80">
			<name x="205" y="50">HelloSent</name>
			<label kind="invariant" x="205" y="95">c_timer &lt;= TIMEOUT</label>
		</location>
		<location id="id2" x="220" y="230">
			<name x="205" y="245">ServerHelloReceived</name>
		</location>
		<location id="id3" x="40" y="230">
			<name x="25" y="245">Connected</name>
		</location>
		<location id="id4" x="400" y="80">
			<name x="385" y="50">DataTransfer</name>
		</location>
		<location id="id5" x="400" y="230">
			<name x="385" y="245">Error</name>
		</location>
		<location id="id6" x="400" y="380">
			<name x="385" y="395">Closed</name>
		</location>
		<init ref="id0"/>
		<transition id="id7">
			<source ref="id0"/>
			<target ref="id1"/>
			<label kind="synchronisation" x="55" y="60">ch_clientHello!</label>
			<label kind="assignment" x="55" y="75">c_timer = 0</label>
		</transition>
		<transition id="id8">
			<source ref="id1"/>
			<target ref="id2"/>
			<label kind="synchronisation" x="140" y="145">ch_serverHello?</label>
		</transition>
		<transition id="id9">
			<source ref="id2"/>
			<target ref="id3"/>
			<label kind="synchronisation" x="55" y="215">ch_clientFinished!</label>
			<label kind="assignment" x="55" y="230">session_client = true, session_established = true</label>
		</transition>
		<transition id="id10">
			<source ref="id3"/>
			<target ref="id4"/>
			<label kind="synchronisation" x="145" y="55">ch_appData!</label>
		</transition>
		<transition id="id11">
			<source ref="id4"/>
			<target ref="id4"/>
			<label kind="synchronisation" x="430" y="55">ch_appData!</label>
			<nail x="370" y="50"/>
			<nail x="430" y="50"/>
		</transition>
		<transition id="id12">
			<source ref="id4"/>
			<target ref="id5"/>
			<label kind="synchronisation" x="415" y="145">ch_alert!</label>
		</transition>
		<transition id="id13">
			<source ref="id1"/>
			<target ref="id6"/>
			<label kind="guard" x="245" y="270">c_timer &gt;= TIMEOUT</label>
			<label kind="synchronisation" x="245" y="285">ch_alert!</label>
		</transition>
		<transition id="id14">
			<source ref="id5"/>
			<target ref="id6"/>
		</transition>
		<transition id="id15">
			<source ref="id6"/>
			<target ref="id0"/>
		</transition>
	</template>
	<template>
		<name>Server</name>
		<location id="id16" x="40" y="80">
			<name x="25" y="50">Init</name>
		</location>
		<location id="id17" x="220" y="80">
			<name x="205" y="50">HelloReceived</name>
		</location>
		<location id="id18" x="220" y="230">
			<name x="205" y="245">HelloSent</name>
		</location>
		<location id="id19" x="40" y="230">
			<name x="25" y="245">FinishedReceived</name>
		</location>
		<location id="id20" x="40" y="380">
			<name x="25" y="395">Session</name>
		</location>
		<location id="id21" x="40" y="500">
			<name x="25" y="515">HR_Computing</name>
