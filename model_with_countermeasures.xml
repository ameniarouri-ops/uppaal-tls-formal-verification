	<system>
system Client, Server, Attacker_POODLE, Attacker_Heartbleed;
</system>
	<queries>
		<query>
			<formula>A[] not deadlock</formula>
			<comment>Absence de deadlock — attendu SATISFAIT</comment>
			<result outcome="success" type="quality" timestamp="2026-04-30 18:21:34 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; session_established</formula>
			<comment>Une session peut etre etablie — attendu SATISFAIT</comment>
			<result outcome="success" type="quality" timestamp="2026-04-30 18:21:36 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; Client.Connected</formula>
			<comment>Le client atteint Connected — attendu SATISFAIT</comment>
			<result outcome="success" type="quality" timestamp="2026-04-30 18:21:38 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; Server.Session</formula>
			<comment>Le serveur atteint Session — attendu SATISFAIT</comment>
			<result outcome="success" type="quality" timestamp="2026-04-30 19:10:23 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; Server.FinishedReceived</formula>
			<comment>Checks whether the server can receive the client's finished message.</comment>
			<result outcome="success" type="quality" timestamp="2026-04-30 19:23:44 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; Attacker_POODLE.downgrade</formula>
			<comment>L attaquant atteint downgrade — attendu SATISFAIT</comment>
			<result outcome="success" type="quality" timestamp="2026-04-30 18:23:05 +0100">
			</result>
		</query>
		<query>
			<formula>A[] not memory_leak</formula>
			<comment>Fuite memoire ne doit jamais arriver — attendu NON SATISFAIT</comment>
			<result outcome="failure" type="quality" timestamp="2026-04-30 18:22:56 +0100">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; Attacker_POODLE.session_decrypted</formula>
			<comment>Checks whether the POODLE attacker can reach the decrypted-session state.</comment>
			<result outcome="success" type="quality" timestamp="2026-04-30 18:22:07 +0100">
			</result>
		</query>

	</queries>
</nta>