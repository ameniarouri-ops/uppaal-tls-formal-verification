			<label kind="synchronisation" x="140" y="145">ch_serverHello!</label>
		</transition>
		<transition id="id27">
			<source ref="id18"/>
			<target ref="id19"/>
			<label kind="synchronisation" x="55" y="215">ch_clientFinished?</label>
		</transition>
		<transition id="id28">
			<source ref="id19"/>
			<target ref="id20"/>
		</transition>
		<transition id="id29">
			<source ref="id20"/>
			<target ref="id22"/>
			<label kind="synchronisation" x="175" y="295">ch_appData?</label>
		</transition>
		<transition id="id30">
			<source ref="id20"/>
			<target ref="id24"/>
			<label kind="synchronisation" x="55" y="580">ch_alert?</label>
		</transition>
		<transition id="id31">
			<source ref="id20"/>
			<target ref="id21"/>
			<label kind="synchronisation" x="-140" y="430">ch_heartbeatReq?</label>
		</transition>
		<transition id="id32">
			<source ref="id21"/>
			<target ref="id20"/>
			<label kind="guard" x="-200" y="450">heartbeat_length &lt;= payload_size</label>
			<label kind="synchronisation" x="-200" y="480">ch_heartbeatResp!</label>
			<label kind="assignment" x="-200" y="465">memory_leak = (heartbeat_length &gt; payload_size)</label>
		</transition>
		<transition id="id33">
			<source ref="id22"/>
			<target ref="id22"/>
			<label kind="synchronisation" x="430" y="270">ch_appData?</label>
			<nail x="370" y="200"/>
			<nail x="430" y="200"/>
		</transition>
		<transition id="id34">
			<source ref="id22"/>
			<target ref="id23"/>
			<label kind="synchronisation" x="430" y="295">ch_heartbeatReq?</label>
		</transition>
		<transition id="id35">
			<source ref="id23"/>
			<target ref="id22"/>
			<label kind="guard" x="430" y="315">heartbeat_length &lt;= payload_size</label>
			<label kind="synchronisation" x="430" y="345">ch_heartbeatResp!</label>
			<label kind="assignment" x="430" y="330">memory_leak = (heartbeat_length &gt; payload_size)</label>
		</transition>
		<transition id="id36">
			<source ref="id22"/>
			<target ref="id24"/>
			<label kind="synchronisation" x="415" y="440">ch_alert?</label>
		</transition>
		<transition id="id37">
			<source ref="id24"/>
			<target ref="id16"/>
		</transition>
	</template>
	<template>
		<name>Attacker_POODLE</name>
		<location id="id38" x="40" y="80">
			<name x="25" y="50">idle</name>
		</location>
		<location id="id39" x="220" y="80">
			<name x="205" y="50">inject</name>
		</location>
		<location id="id40" x="220" y="230">
			<name x="205" y="245">retry</name>
		</location>
		<location id="id41" x="40" y="230">
			<name x="25" y="245">downgrade</name>
		</location>
		<location id="id42" x="400" y="80">
			<name x="385" y="50">downgrade_achieved</name>
		</location>
		<location id="id43" x="400" y="230">
			<name x="385" y="245">padding_oracle</name>
		</location>
		<location id="id44" x="580" y="230">
			<name x="565" y="245">session_decrypted</name>
		</location>
		<init ref="id38"/>
		<transition id="id45">
			<source ref="id38"/>
			<target ref="id39"/>
			<label kind="assignment" x="55" y="60">retry_count = 0</label>
		</transition>
		<transition id="id46">
			<source ref="id39"/>
			<target ref="id40"/>
			<label kind="guard" x="140" y="130">version_negotiated &gt; 0</label>
			<label kind="assignment" x="140" y="145">version_negotiated = version_negotiated - 1</label>
		</transition>
		<transition id="id47">
			<source ref="id40"/>
			<target ref="id41"/>
			<label kind="assignment" x="55" y="215">retry_count = retry_count + 1</label>
		</transition>
		<transition id="id48">
			<source ref="id41"/>
			<target ref="id39"/>
			<label kind="guard" x="55" y="145">version_negotiated &gt; 0 &amp;&amp; retry_count &lt; MAX_RETRY</label>
		</transition>
		<transition id="id49">
			<source ref="id41"/>
			<target ref="id42"/>
			<label kind="guard" x="160" y="125">version_negotiated == 0</label>
		</transition>
		<transition id="id50">
			<source ref="id42"/>
